# =============================================================================
# TRACE-Kin v2 smoke test
# =============================================================================
# Submit with:
#     bsub < training/run_v2_smoke_test.lsf
#
# Purpose: catch import / config / CUDA-arch problems with the v2 architecture
# *before* committing to the 14-task rerun array. Runs train_trace_kin.py with
# a tiny sample (100 rows, 2 epochs) on one fixed dataset so it finishes in a
# few minutes. Walltime capped at 30 minutes.
#
# After this job finishes, chain the rerun array to it:
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v2_rerun_array.lsf
# =============================================================================

# --- Environment -------------------------------------------------------------
# Match the prologue of the proven-working PSICHIC LSFs verbatim — no
# `set -euo pipefail`. Mount Sinai's /etc/profile.d scripts return non-zero
# in places that aren't real errors, and errexit aborts the job before
# module + conda activation can complete.
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Put the repo root on PYTHONPATH so `from training.X import …` works when
# train_trace_kin.py is invoked as a script (not via `python -m`).
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (override via env if desired) ------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
SMOKE_DATASET_DIR="${SMOKE_DATASET_DIR:-$ENZYME_BASE/MPEK_dataset/MPEK_kcat_ESMv1_embedding_random}"
SMOKE_RESULT_BASE="${SMOKE_RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v2/_smoke}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v2.json}"


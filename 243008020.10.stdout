# LSBATCH: User input
#!/bin/bash
#BSUB -J trace_kin_v6c_perfolder_s1[1-10]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1

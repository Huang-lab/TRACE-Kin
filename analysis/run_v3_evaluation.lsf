#!/bin/bash
#BSUB -J trace_kin_v3_eval
#BSUB -P acc_DiseaseGeneCell
#BSUB -q premium
#BSUB -n 4
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 00:30
#BSUB -o %J.eval.stdout
#BSUB -eo %J.eval.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v3 evaluation pipeline (Phase 1: aggregate + check + gate)
# =============================================================================
# Submit with:
#     bsub < analysis/run_v3_evaluation.lsf
#
# CPU-only — no GPU needed for any of the three steps. Walltime cap 30 min
# (typical run is 1-3 minutes). 4 cores + 8 GB is plenty for pandas + numpy
# work over ~14 tasks × 3 seeds of test_prediction CSVs.
#
# Pipeline (each step is gated on the prior succeeding):
#   1. analysis/aggregate_results.py     — averages predictions across all
#                                           test_prediction_seed*.csv per task,
#                                           computes ensemble RMSE, joins v1 +
#                                           RF baselines from the cleaned
#                                           historical benchmark.
#                                           Output: data/benchmark/trace_kin_v3_results.csv
#   2. analysis/check_improvement.py     — human-readable per-task table with
#                                           v1 / v3 / RF columns + per-row
#                                           verdict + per-kinetic aggregate +
#                                           one-paragraph headline.
#                                           Output: data/benchmark/improvement_summary.md
#                                           Exit code 0 if catalytic gate PASS, 1 otherwise.
#   3. analysis/promotion_gate.py        — binding PASS/FAIL with per-kinetic
#                                           breakdown + Ki preservation guard.
#                                           Output: data/benchmark/promotion_gate_decision.md
#
# After this finishes, sync the three output files back to local via git:
#   On HPC:    git add data/benchmark/trace_kin_v3_results.csv \
#                      data/benchmark/improvement_summary.md \
#                      data/benchmark/promotion_gate_decision.md
#              git commit -m "v3 evaluation results (job <JOBID>)"
#              git push origin main
#   On Mac:    git pull origin main
# =============================================================================

# --- Environment -------------------------------------------------------------
# Match the prologue of the proven-working PSICHIC LSFs verbatim — no
# `set -euo pipefail`. Mount Sinai's /etc/profile.d scripts return non-zero
# in places that aren't real errors. CUDA is intentionally NOT loaded — these
# are CPU-only pandas/numpy/sklearn scripts.
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
# Put the repo root on PYTHONPATH so `from training.X import …` (used by
# analysis/aggregate_results.py via shared utility imports) resolves correctly.
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v3}"
CLEAN_CSV="${CLEAN_CSV:-data/benchmark/kinetic_regress_benchmark_clean.csv}"
AGGREGATED_CSV="${AGGREGATED_CSV:-data/benchmark/trace_kin_v3_results.csv}"
IMPROVEMENT_MD="${IMPROVEMENT_MD:-data/benchmark/improvement_summary.md}"
GATE_MD="${GATE_MD:-data/benchmark/promotion_gate_decision.md}"

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v3 evaluation pipeline"
echo "=========================================="
echo "Date:               $(date)"
echo "Result base:        $RESULT_BASE"
echo "Clean baseline CSV: $CLEAN_CSV"
echo "Aggregated CSV:     $AGGREGATED_CSV"
echo "Improvement MD:     $IMPROVEMENT_MD"
echo "Gate MD:            $GATE_MD"
echo "=========================================="

python --version
echo "Python: $(which python)"

# Quick existence check on the result tree before doing any work.
if [ ! -d "$RESULT_BASE" ]; then
    echo "ERROR: RESULT_BASE does not exist: $RESULT_BASE"
    exit 2
fi
n_pred_csvs=$(find "$RESULT_BASE" -name "test_prediction_seed*.csv" | wc -l)
echo "Found $n_pred_csvs test_prediction_seed*.csv files under $RESULT_BASE"
if [ "$n_pred_csvs" -lt 14 ]; then
    echo "WARN: expected 14+ result CSVs (one per task, possibly multi-seed); found $n_pred_csvs"
    echo "      Pipeline will continue with whatever results are present."
fi

# --- Step 1: aggregate per-task ensemble RMSEs ------------------------------
echo ""
echo "=========================================="
echo "Step 1/3: aggregate_results.py"
echo "    averages predictions across all seeds per task,"
echo "    then computes ensemble RMSE; joins v1 + RF baselines."
echo "=========================================="
python analysis/aggregate_results.py \
    --results_root "$RESULT_BASE" \
    --clean_csv    "$CLEAN_CSV" \
    --output       "$AGGREGATED_CSV"
agg_rc=$?
if [ $agg_rc -ne 0 ]; then
    echo ""
    echo "ERROR: aggregate_results.py failed with exit code $agg_rc"
    echo "Cannot proceed to check_improvement / promotion_gate without the aggregated CSV."
    exit 1
fi
echo ""
echo "OK — wrote $AGGREGATED_CSV"
echo "Row count:"
wc -l "$AGGREGATED_CSV"
echo "Preview (first 3 data rows):"
head -4 "$AGGREGATED_CSV"

# --- Step 2: human-readable improvement summary ------------------------------
echo ""
echo "=========================================="
echo "Step 2/3: check_improvement.py"
echo "    per-task table with v1 / v3 / RF + per-row verdict +"
echo "    per-kinetic aggregate + headline summary."
echo "=========================================="
python analysis/check_improvement.py \
    --v3_csv "$AGGREGATED_CSV" \
    --output "$IMPROVEMENT_MD"
chk_rc=$?
echo ""
echo "check_improvement.py exit code: $chk_rc"
echo "    (0 = catalytic gate PASS — ≥3 of 4 kinetics beat RF;"
echo "     1 = catalytic gate FAIL;"
echo "     2 = error reading aggregated CSV)"
if [ $chk_rc -eq 2 ]; then
    echo "ERROR: check_improvement.py could not read the aggregated CSV. Aborting."
    exit 1
fi
echo "Wrote $IMPROVEMENT_MD"

# --- Step 3: official promotion-gate verdict --------------------------------
echo ""
echo "=========================================="
echo "Step 3/3: promotion_gate.py"
echo "    binding PASS/FAIL verdict with per-kinetic breakdown +"
echo "    Ki preservation guard."
echo "=========================================="
python analysis/promotion_gate.py \
    --v3_csv "$AGGREGATED_CSV" \
    --output "$GATE_MD"
gate_rc=$?
echo ""
echo "promotion_gate.py exit code: $gate_rc"
echo "Wrote $GATE_MD"

# --- Final summary ----------------------------------------------------------
echo ""
echo "=========================================="
echo "Pipeline complete."
echo "=========================================="
echo ""
echo "Output files:"
ls -la "$AGGREGATED_CSV" "$IMPROVEMENT_MD" "$GATE_MD" 2>&1
echo ""
echo "--- Headline from check_improvement.py ---"
grep -A 2 "^## Headline" "$IMPROVEMENT_MD" | tail -3 2>&1
echo ""
echo "--- Verdict tail from promotion_gate_decision.md ---"
tail -25 "$GATE_MD" 2>&1
echo ""
echo "=========================================="
echo "Next step: commit + push the 3 output files so you can pull them locally."
echo ""
echo "  git add $AGGREGATED_CSV $IMPROVEMENT_MD $GATE_MD"
echo "  git commit -m \"v3 evaluation results (job $LSB_JOBID)\""
echo "  git push origin main"
echo "=========================================="

# Exit with the gate verdict's code so downstream jobs (if any) can chain on it.
if [ $chk_rc -eq 0 ]; then
    echo "Catalytic gate verdict: PASS (exiting 0)"
    exit 0
else
    echo "Catalytic gate verdict: FAIL (exiting 1)"
    exit 1
fi

#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v6c (Hierarchical Pocket Graph + MMCAF) PER-FOLDER — top-10 cells
# =============================================================================
# Submit with:
#     bsub < training/run_v6c_perfolder_s1.lsf
#
# v6c = Pocket Graph: MutaPLM per-residue (4096) -> Linear(512) -> GATv2 on
# contact-map graph (3 layers, 8 heads) -> dynamic pocket identification
# (top-64 residues via cross-attn) -> MMCAF at pocket level -> hierarchical
# pooling (gated pocket + global fusion) -> regression head.
# Ligand: PNA GNN + MoLFormer-XL (768-d) context.
#
# All cells use MUTAPLM embedding.
#
# For seeds 2 and 3, submit:
#     bsub < training/run_v6c_perfolder_s2.lsf
#     bsub < training/run_v6c_perfolder_s3.lsf
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v6c_pocket_graph}"
MOLFORMER_PATH="${MOLFORMER_PATH:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/transformersmodels/ibm/MoLFormer-XL-both-10pct}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v6c.json}"
EPOCHS="${EPOCHS:-100}"
BATCH_SIZE="${BATCH_SIZE:-32}"


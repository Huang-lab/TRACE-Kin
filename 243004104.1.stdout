# =============================================================================
# TRACE-Kin v5t (Vanilla Transformer + Cross-Attention) PER-FOLDER — top-10 cells
# =============================================================================
# Submit with:
#     bsub < training/run_v5t_perfolder_s1.lsf
#
# v5t = Transformer: MutaPLM per-residue (4096) -> Linear(512) -> Transformer
# self-attention x4 with Rotary PE -> cross-attention with ligand atoms
# (PNA + MoLFormer) -> substrate-conditioned pooling -> regression head.
#
# All cells use MUTAPLM embedding.
#
# For seeds 2 and 3, submit:
#     bsub < training/run_v5t_perfolder_s2.lsf
#     bsub < training/run_v5t_perfolder_s3.lsf
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"

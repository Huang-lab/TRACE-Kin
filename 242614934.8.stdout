# =============================================================================
# TRACE-Kin v3 rerun — LSF job array
# =============================================================================
# Submit with:
#     bsub < training/run_v3_array.lsf
#
# Or chain off the smoke test (recommended):
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v3_array.lsf
#
# For the multi-seed ensemble (the paper config), submit additional seeds in
# parallel after the SEED=1 array completes (or alongside, as separate jobs):
#     SEED=2 bsub -J "trace_kin_v3_s2[1-14]" < training/run_v3_array.lsf
#     SEED=3 bsub -J "trace_kin_v3_s3[1-14]" < training/run_v3_array.lsf
# After all seeds finish, analysis/aggregate_results.py averages predictions
# across seeds before computing RMSE.
#
# LSF expands #BSUB -J trace_kin_v3[1-14] into 14 array tasks, each with a
# distinct ${LSB_JOBINDEX} in 1..14. The body looks up the per-index
# (dataset_source, dataset_name, pool_paths) tuple from the inline table below
# and invokes train_trace_kin.py with model_version=v3.
#
# The 14 tasks correspond to:
#   * 12 RF-gap targets (catalytic kinetics where v1 trails RF by 1.4%–8.7%)
#   * 2 Ki preservation guards (where v1 already wins, must not regress)
# =============================================================================

# --- Environment -------------------------------------------------------------
# Match the prologue of the proven-working PSICHIC LSFs verbatim — no
# `set -euo pipefail`. Mount Sinai's /etc/profile.d scripts return non-zero
# in places that aren't real errors, and errexit aborts the job before
# module + conda activation can complete.
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0


# =============================================================================
# TRACE-Kin v7 (SGED) PER-FOLDER — top-10 cells, seed 1
# =============================================================================
# Submit with:
#     bsub < training/run_v7_perfolder_s1.lsf
#
# v7 = SGED (Structure-Guided Embedding Distillation):
#   Structure Stream: MutaPLM -> Linear(512) -> RWSE -> GATv2 (3 layers, 8 heads)
#                     -> pocket identification (cross-attn) -> MMCAF -> struct pool
#   Embedding Stream: raw MutaPLM (4096-d) -> Mutation-Aware Gate
#                     -> Multi-Scale PCER (catalytic K=16, pocket K=64, global)
#                     -> scale gating -> pcer pool
#   Ligand: PNA GNN + MoLFormer-XL (768-d) context.
#   Prediction: concat(lig_pool, struct_pool, pcer_pool) -> deeper MLP -> y
#
# For seeds 2 and 3, submit:
#     bsub < training/run_v7_perfolder_s2.lsf
#     bsub < training/run_v7_perfolder_s3.lsf
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v7_sged}"
MOLFORMER_PATH="${MOLFORMER_PATH:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/transformersmodels/ibm/MoLFormer-XL-both-10pct}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v7.json}"
EPOCHS="${EPOCHS:-100}"


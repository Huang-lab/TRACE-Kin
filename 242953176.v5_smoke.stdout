#BSUB -R "span[hosts=1]"
#BSUB -W 01:00
#BSUB -o %J.v5_smoke.stdout
#BSUB -eo %J.v5_smoke.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v5 (Graph-Mamba + Cross-Attention) smoke test
# =============================================================================
# Submit with:
#     bsub < training/run_v5_smoke_test.lsf
#
# Purpose: validate the v5 architecture end-to-end on one cell before
# committing the 10-cell x 3-seed array. Catches:
#   - MutaPLM per-residue embedding loaded from parquet (L, 4096)
#   - Linear projection 4096 -> 512
#   - Graph structural encoding (RWSE from contact-map)
#   - Bidirectional Mamba forward/backward scan
#   - Graph-gated aggregation from contact-map edges
#   - Cross-attention between residues and ligand atoms
#   - Substrate-conditioned pooling
#   - MoLFormer-XL context injection to ligand atoms
#   - Final regression head + test prediction CSV
#
# Runs train_trace_kin.py with a tiny sample (100 rows, 5 epochs) on
# the EITLEM kkm cold_drug MUTAPLM cell. Walltime 1h (Mamba sequential
# scan is slower than parallelized GNN on small data).
#
# After success, chain the per-folder arrays:
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v5_perfolder_s1.lsf
#     bsub < training/run_v5_perfolder_s2.lsf
#     bsub < training/run_v5_perfolder_s3.lsf
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

(... more ...)

#!/bin/bash
#BSUB -J trace_kin_v1[1-14]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 48:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v1 baseline rerun — LSF job array
# =============================================================================
# Submit with:
#     bsub < training/run_v1_baseline_array.lsf
#
# Mirror image of run_v2_rerun_array.lsf but with model_version=v1, no SWA,
# no cross-dataset pooling, and the v1 config. Use this if you want a fresh
# v1 reproduction on the exact same 14 dataset configs the v2 rerun uses, so
# v1-vs-v2 comparison is apples-to-apples even if the historical CSV had any
# drift. Optional but recommended for the paper's reproducibility statement.
#
# Results land in TRACE_Kin_Results_v1_repro/ (separate from the historical
# TRACE_Kin_Results/ tree so you can diff cleanly).
# =============================================================================

# Match the prologue of the proven-working PSICHIC LSFs verbatim — no
# `set -euo pipefail`. Mount Sinai's /etc/profile.d scripts return non-zero
# in places that aren't real errors, and errexit aborts the job before
# module + conda activation can complete.
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Put the repo root on PYTHONPATH so `from training.X import …` works when
# train_trace_kin.py is invoked as a script (not via `python -m`).
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v1_repro}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v1.json}"
EPOCHS="${EPOCHS:-100}"
BATCH_SIZE="${BATCH_SIZE:-16}"
SEED="${SEED:-1}"
LRATE="${LRATE:-1e-4}"

# Same 14 rows as the v2 array — pools are intentionally ignored for v1 since
# the historical benchmark did not pool. v1-on-this-config is the apples-to-
# apples comparator for v2-on-this-config.
JOBS=(
    "EITLEM_dataset|EITLEM_km_ESMv1_embedding_random"
    "EITLEM_dataset|EITLEM_km_ProteinCLIP_embedding_cold_protein"
    "MPEK_dataset|MPEK_kcat_ESMv1_embedding_random"
    "MPEK_dataset|MPEK_kcat_ESMv1_embedding_cold_drug"
    "MPEK_dataset|MPEK_kcat_ESM2_embedding_cold_protein"
    "inhouse_dataset|inhouse_Kd_MUTAPLM_embedding_random"
    "inhouse_dataset|inhouse_Kd_ESM2_embedding_cold_drug"
    "inhouse_dataset|inhouse_Kd_ESM2_embedding_cold_protein"
    "EITLEM_dataset|EITLEM_kkm_ProteinCLIP_embedding_random"
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_cold_drug"
    "EITLEM_dataset|EITLEM_kkm_ProteinCLIP_embedding_cold_protein"
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_cold_protein"
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_random"
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_cold_drug"
)

IDX=$((LSB_JOBINDEX - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#JOBS[@]}" ]; then
    echo "ERROR: LSB_JOBINDEX=$LSB_JOBINDEX out of range (1..${#JOBS[@]})"
    exit 2
fi
ROW="${JOBS[$IDX]}"
IFS='|' read -r SRC NAME <<< "$ROW"

DATASET_DIR="$ENZYME_BASE/$SRC/$NAME"
RESULT_PATH="$RESULT_BASE/$SRC/$NAME"

echo "=========================================="
echo "TRACE-Kin v1 baseline array task ${LSB_JOBINDEX}/14"
echo "=========================================="
echo "Date:        $(date)"
echo "Dataset:     $DATASET_DIR"
echo "Result:      $RESULT_PATH"
echo "Config:      $CONFIG_PATH"
echo "Model:       v1 (no SWA, no pooling)"
echo "Epochs:      $EPOCHS, batch=$BATCH_SIZE, seed=$SEED, lr=$LRATE"
echo "=========================================="

python --version
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
name = torch.cuda.get_device_name(0)
cap = torch.cuda.get_device_capability(0)
print(f"CUDA device: {name}, sm_{cap[0]}{cap[1]}")
PY

python training/train_trace_kin.py \
    --datafolder "$DATASET_DIR" \
    --result_path "$RESULT_PATH" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs "$EPOCHS" \
    --batch_size "$BATCH_SIZE" \
    --seed "$SEED" \
    --lrate "$LRATE" \
    --protein_col Sequence \
    --feature_col protein_features \
    --ligand_col Smiles \
    --label_col Label \
    --regression_task \
    --model_version v1 \
    --no_swa

if ls "$RESULT_PATH"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "Array task ${LSB_JOBINDEX}/14: OK ($NAME)"
    exit 0
else
    echo ""
    echo "Array task ${LSB_JOBINDEX}/14: FAIL ($NAME)"
    exit 1
fi

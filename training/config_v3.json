{
    "_comment": "TRACE-Kin v3 config: dual-head architecture (v1 GNN + FP-MLP head fed ESM mean ⊕ ChemBERT 768) combined via a learned per-sample sigmoid gate. ChemBERT features come from per-row metabolite_features in the parquet files. fp_dropout (0.1) regularizes the FP-MLP head only — the GNN dropout stays at 0 to preserve v1 backbone behavior. patience=10 enables early stopping (FP-MLP head was overfitting to small per-folder train sets in the first ChemBERT runs, peaking by epoch ~10).",
    "model_version": "v3",
    "tasks": {
        "regression_task": false,
        "classification_task": false,
        "mclassification_task": 0
    },
    "optimizer": {
        "lrate": 0.0001,
        "weight_decay": 0.0001,
        "clip": 1,
        "betas": [0.9, 0.999],
        "eps": 1e-08,
        "schedule_lr": false,
        "min_lrate": 0,
        "warmup_iters": 0,
        "lr_decay_iters": null,
        "amsgrad": false,
        "patience": 10
    },
    "params": {
        "mol_in_channels": 43,
        "prot_in_channels": 33,
        "prot_evo_channels": 1280,
        "hidden_channels": 200,
        "aggregators": ["mean", "min", "max", "std"],
        "scalers": ["identity", "amplification", "linear"],
        "pre_layers": 2,
        "post_layers": 1,
        "total_layer": 3,
        "K": [5, 10, 20],
        "dropout": 0,
        "dropout_attn_score": 0.2,
        "heads": 5,
        "chembert_dim": 768,
        "rf_head_hidden": [512, 128],
        "fp_dropout": 0.1,
        "gate_hidden": 64,
        "gate_init_bias": 0.0
    },
    "swa": {
        "use_swa": false,
        "swa_start_frac": 0.75,
        "swa_lr_factor": 0.1
    }
}

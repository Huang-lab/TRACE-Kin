#!/bin/bash
#BSUB -J trace_kin_v2[1-14]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 48:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v2 rerun — LSF job array
# =============================================================================
# Submit with:
#     bsub < training/run_v2_rerun_array.lsf
#
# Or chain off the smoke test (recommended):
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v2_rerun_array.lsf
#
# LSF expands #BSUB -J trace_kin_v2[1-14] into 14 array tasks, each with a
# distinct ${LSB_JOBINDEX} in 1..14. The body looks up the per-index
# (dataset_source, dataset_name, pool_paths) tuple from the inline table below
# and invokes train_trace_kin.py with model_version=v2 + SWA.
#
# The 14 tasks correspond to:
#   * 12 RF-gap targets (catalytic kinetics where v1 trails RF by 1.4%–8.7%)
#   * 2 Ki preservation guards (where v1 already wins, must not regress)
# =============================================================================

set -euo pipefail

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Knobs (env overrides) ---------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v2}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v2.json}"
EPOCHS="${EPOCHS:-100}"
BATCH_SIZE="${BATCH_SIZE:-16}"
SEED="${SEED:-1}"
LRATE="${LRATE:-1e-4}"

# --- Per-array-index table ---------------------------------------------------
# Each line: SOURCE|DATASET_NAME|POOL_DIRS (semicolon-separated, optional)
# POOL_DIRS are relative to ENZYME_BASE; converted to absolute paths below.
JOBS=(
    "EITLEM_dataset|EITLEM_km_ESMv1_embedding_random|MPEK_dataset/MPEK_km_ESMv1_embedding_random;catpred_dataset/catpred_km_ESMv1_embedding_random"
    "EITLEM_dataset|EITLEM_km_ProteinCLIP_embedding_cold_protein|MPEK_dataset/MPEK_km_ProteinCLIP_embedding_cold_protein;catpred_dataset/catpred_km_ProteinCLIP_embedding_cold_protein"
    "MPEK_dataset|MPEK_kcat_ESMv1_embedding_random|EITLEM_dataset/EITLEM_kcat_ESMv1_embedding_random;catpred_dataset/catpred_kcat_ESMv1_embedding_random"
    "MPEK_dataset|MPEK_kcat_ESMv1_embedding_cold_drug|EITLEM_dataset/EITLEM_kcat_ESMv1_embedding_cold_drug;catpred_dataset/catpred_kcat_ESMv1_embedding_cold_drug"
    "MPEK_dataset|MPEK_kcat_ESM2_embedding_cold_protein|EITLEM_dataset/EITLEM_kcat_ESM2_embedding_cold_protein;catpred_dataset/catpred_kcat_ESM2_embedding_cold_protein"
    "inhouse_dataset|inhouse_Kd_MUTAPLM_embedding_random|"
    "inhouse_dataset|inhouse_Kd_ESM2_embedding_cold_drug|"
    "inhouse_dataset|inhouse_Kd_ESM2_embedding_cold_protein|"
    "EITLEM_dataset|EITLEM_kkm_ProteinCLIP_embedding_random|"
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_cold_drug|"
    "EITLEM_dataset|EITLEM_kkm_ProteinCLIP_embedding_cold_protein|"
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_cold_protein|"
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_random|"
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_cold_drug|"
)

# --- Resolve this array task's row ------------------------------------------
IDX=$((LSB_JOBINDEX - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#JOBS[@]}" ]; then
    echo "ERROR: LSB_JOBINDEX=$LSB_JOBINDEX out of range (1..${#JOBS[@]})"
    exit 2
fi
ROW="${JOBS[$IDX]}"
IFS='|' read -r SRC NAME POOLS <<< "$ROW"

DATASET_DIR="$ENZYME_BASE/$SRC/$NAME"
RESULT_PATH="$RESULT_BASE/$SRC/$NAME"

# Build absolute pool path list, comma-separated.
POOL_TRAIN_CSVS=""
if [ -n "$POOLS" ]; then
    IFS=';' read -ra REL_LIST <<< "$POOLS"
    ABS_LIST=()
    for rel in "${REL_LIST[@]}"; do
        ABS_LIST+=("$ENZYME_BASE/$rel")
    done
    POOL_TRAIN_CSVS=$(IFS=','; echo "${ABS_LIST[*]}")
fi

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v2 array task ${LSB_JOBINDEX}/14"
echo "=========================================="
echo "Date:        $(date)"
echo "Dataset:     $DATASET_DIR"
echo "Result:      $RESULT_PATH"
echo "Config:      $CONFIG_PATH"
echo "Pool CSVs:   ${POOL_TRAIN_CSVS:-(none)}"
echo "Model:       v2 + SWA"
echo "Epochs:      $EPOCHS, batch=$BATCH_SIZE, seed=$SEED, lr=$LRATE"
echo "=========================================="

python --version
echo "Python: $(which python)"
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
name = torch.cuda.get_device_name(0)
cap = torch.cuda.get_device_capability(0)
print(f"CUDA device: {name}, sm_{cap[0]}{cap[1]}")
PY

# --- Train -------------------------------------------------------------------
EXTRA_ARGS=()
if [ -n "$POOL_TRAIN_CSVS" ]; then
    EXTRA_ARGS+=(--pool_train_csvs "$POOL_TRAIN_CSVS")
fi

python training/train_trace_kin.py \
    --datafolder "$DATASET_DIR" \
    --result_path "$RESULT_PATH" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs "$EPOCHS" \
    --batch_size "$BATCH_SIZE" \
    --seed "$SEED" \
    --lrate "$LRATE" \
    --protein_col Sequence \
    --feature_col protein_features \
    --ligand_col Smiles \
    --label_col Label \
    --regression_task \
    --model_version v2 \
    --use_swa \
    "${EXTRA_ARGS[@]}"

# --- Result check ------------------------------------------------------------
if ls "$RESULT_PATH"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/14: OK ($NAME)"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/14: FAIL ($NAME)"
    echo "No test_prediction_seed*.csv at $RESULT_PATH"
    echo "=========================================="
    exit 1
fi

#!/bin/bash
#BSUB -J trace_kin_v6b_xgb[1-10]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=15000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 04:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v6b: XGBoost on v5t deep features — top-10 cells
# =============================================================================
# Submit with:
#     bsub < training/run_v6b_xgboost.lsf
#
# Requires: a trained v5t checkpoint for each cell. Set V5T_RESULT_BASE to
# the directory containing v5t results (with best_model.pt per cell).
#
# This extracts the 1024-d interaction_fingerprint from v5t and trains
# XGBoost on top. Much faster than full neural training (<1hr per cell).
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs -------------------------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
V5T_RESULT_BASE="${V5T_RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v5t_transformer}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v6b_xgboost}"
MOLFORMER_PATH="${MOLFORMER_PATH:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/transformersmodels/ibm/MoLFormer-XL-both-10pct}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v5t.json}"
SEED=1

# --- Per-array-index table (same 10 cells as v5t) ----------------------------
JOBS=(
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_cold_drug"
    "catpred_dataset|catpred_kcat_MUTAPLM_embedding_random"
    "inhouse_dataset|inhouse_Kd_MUTAPLM_embedding_random"
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_random"
    "EITLEM_dataset|EITLEM_kcat_MUTAPLM_embedding_cold_drug"
    "MPEK_dataset|MPEK_kcat_MUTAPLM_embedding_cold_protein"
    "EITLEM_dataset|EITLEM_km_MUTAPLM_embedding_cold_protein"
    "catpred_dataset|catpred_ki_MUTAPLM_embedding_cold_protein"
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_cold_protein"
    "EITLEM_dataset|EITLEM_kcat_MUTAPLM_embedding_cold_protein"
)

# --- Resolve this array task's row ------------------------------------------
IDX=$((LSB_JOBINDEX - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#JOBS[@]}" ]; then
    echo "ERROR: LSB_JOBINDEX=$LSB_JOBINDEX out of range (1..${#JOBS[@]})"
    exit 2
fi
ROW="${JOBS[$IDX]}"
IFS='|' read -r SRC NAME <<< "$ROW"

DATASET_DIR="$ENZYME_BASE/$SRC/$NAME"
RESULT_PATH="$RESULT_BASE/$SRC/$NAME"
V5T_CHECKPOINT="$V5T_RESULT_BASE/$SRC/$NAME/best_model.pt"

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v6b (XGBoost on v5t features) task ${LSB_JOBINDEX}/${#JOBS[@]}"
echo "=========================================="
echo "Date:           $(date)"
echo "Dataset:        $DATASET_DIR"
echo "v5t checkpoint: $V5T_CHECKPOINT"
echo "Result:         $RESULT_PATH"
echo "Seed:           $SEED"
echo "=========================================="

# Check that v5t checkpoint exists
if [ ! -f "$V5T_CHECKPOINT" ]; then
    echo "ERROR: v5t checkpoint not found: $V5T_CHECKPOINT"
    echo "Run v5t per-folder jobs first."
    exit 1
fi

python --version
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
print(f"CUDA device: {torch.cuda.get_device_name(0)}")
PY

# --- Run v6b -----------------------------------------------------------------
python training/v6b_xgboost_on_v5t_features.py \
    --v5t_checkpoint "$V5T_CHECKPOINT" \
    --datafolder "$DATASET_DIR" \
    --config_path "$CONFIG_PATH" \
    --molformer_path "$MOLFORMER_PATH" \
    --result_path "$RESULT_PATH" \
    --protein_col Sequence \
    --feature_col protein_features \
    --ligand_col Smiles \
    --label_col Label \
    --device cuda:0 \
    --seed "$SEED" \
    --batch_size 64

# --- Result check ------------------------------------------------------------
if ls "$RESULT_PATH"/v6b_test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: OK ($NAME)"
    echo "=========================================="
else
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: FAIL ($NAME)"
    echo "=========================================="
    exit 1
fi

        "weight_decay": 0.01,
        "clip": 1,
        "betas": [0.9, 0.999],
        "eps": 1e-08,
        "schedule_lr": true,
        "min_lrate": 1e-06,
        "warmup_iters": 0,
        "lr_decay_iters": null,
        "amsgrad": false,
        "patience": 15
    },
    "params": {

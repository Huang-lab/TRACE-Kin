{
    "_comment": "TRACE-Kin v3 GATE-LEAN config (gate_init_bias=2.0, initial alpha approx 0.88). Forces the gate to start GNN-leaning so that on tasks WITHOUT cross-dataset pooling (Kd, kcat/Km), the FP-MLP path does not drown out the GNN signal early in training. Use ONLY for the failing tasks 6-11; the default config_v3.json (gate_init_bias=0.0) wins on the pooled tasks 1-5 and on Ki and should be kept there.",
    "model_version": "v3",
    "tasks": {
        "regression_task": false,
        "classification_task": false,
        "mclassification_task": 0
    },
    "optimizer": {
        "lrate": 0.0001,
        "weight_decay": 0.0001,
        "clip": 1,
        "betas": [0.9, 0.999],
        "eps": 1e-08,
        "schedule_lr": false,
        "min_lrate": 0,
        "warmup_iters": 0,
        "lr_decay_iters": null,
        "amsgrad": false,
        "patience": 0
    },
    "params": {
        "mol_in_channels": 43,
        "prot_in_channels": 33,
        "prot_evo_channels": 1280,
        "hidden_channels": 200,
        "aggregators": ["mean", "min", "max", "std"],
        "scalers": ["identity", "amplification", "linear"],
        "pre_layers": 2,
        "post_layers": 1,
        "total_layer": 3,
        "K": [5, 10, 20],
        "dropout": 0,
        "dropout_attn_score": 0.2,
        "heads": 5,
        "morgan_dim": 2048,
        "morgan_radius": 2,
        "maccs_dim": 167,
        "rf_head_hidden": [512, 128],
        "gate_hidden": 64,
        "gate_init_bias": 2.0
    },
    "swa": {
        "use_swa": false,
        "swa_start_frac": 0.75,
        "swa_lr_factor": 0.1
    }
}

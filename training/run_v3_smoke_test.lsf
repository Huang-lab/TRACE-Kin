#!/bin/bash
#BSUB -J trace_kin_v3_smoke
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 8
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 00:30
#BSUB -o %J.v3_smoke.stdout
#BSUB -eo %J.v3_smoke.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v3 + MoLFormer-XL context residual smoke test
# =============================================================================
# Submit with:
#     bsub < training/run_v3_smoke_test.lsf
#
# Purpose: validate the v3-with-MoLFormer-XL-context pipeline end-to-end
# on one cell before committing the 10-cell × 3-seed perfolder array.
# Catches:
#   - MoLFormer-XL HuggingFace load + tokenizer (transformers, trust_remote_code)
#   - compute_molformer_embeddings live inference + cache write
#   - chembert_fp shape (B, 768) flowing through MultiGraphData → trainer
#   - net_v3 chembert_proj (Linear 768 → 200) + reg_out fresh head
#   - zero-init chembert_proj means epoch 0 ≈ v1 baseline (sanity check)
#   - SWA enabled in config — confirm no crash even though smoke uses few epochs
#
# Runs train_trace_kin.py with a tiny sample (100 rows, 2 epochs) on one
# fixed dataset so it finishes in a few minutes. Walltime capped at 30 min.
#
# After this job finishes, chain the perfolder arrays to it:
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v3_perfolder_s1.lsf
#     bsub < training/run_v3_perfolder_s2.lsf
#     bsub < training/run_v3_perfolder_s3.lsf
# (s2 and s3 don't need the dependency: each cell rebuilds its own cache
# unconditionally, so all three seeds can run independently.)
# =============================================================================

# --- Environment -------------------------------------------------------------
# Match the prologue of the proven-working PSICHIC LSFs verbatim — no
# `set -euo pipefail`. Mount Sinai's /etc/profile.d scripts return non-zero
# in places that aren't real errors, and errexit aborts the job before
# module + conda activation can complete.
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Put the repo root on PYTHONPATH so `from training.X import …` works when
# train_trace_kin.py is invoked as a script (not via `python -m`).
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (override via env if desired) ------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
SMOKE_DATASET_DIR="${SMOKE_DATASET_DIR:-$ENZYME_BASE/MPEK_dataset/MPEK_kcat_ESMv1_embedding_random}"
SMOKE_RESULT_BASE="${SMOKE_RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v3_molformer_ctx/_smoke}"
MOLFORMER_PATH="${MOLFORMER_PATH:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/transformersmodels/ibm/MoLFormer-XL-both-10pct}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v3.json}"

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v3 + MoLFormer-XL Context Residual Smoke Test"
echo "=========================================="
echo "Date:               $(date)"
echo "Dataset:            $SMOKE_DATASET_DIR"
echo "Result dir:         $SMOKE_RESULT_BASE"
echo "Config:             $CONFIG_PATH"
echo "MoLFormer:          $MOLFORMER_PATH"
echo "Sample size:        100 rows train / 50 test"
echo "Epochs:             2"
echo "Mol context:        Linear(768 -> 200) added as residual to mol_pool"
echo "=========================================="

python --version
echo "Python: $(which python)"

# --- GPU smoke ---------------------------------------------------------------
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
name = torch.cuda.get_device_name(0)
cap = torch.cuda.get_device_capability(0)
print(f"CUDA device: {name}, sm_{cap[0]}{cap[1]}")
PY

# --- Wipe any prior smoke output so the success check is honest --------------
rm -rf "$SMOKE_RESULT_BASE"
mkdir -p "$SMOKE_RESULT_BASE"

# --- Run a tiny v3 training -------------------------------------------------
# --force_rebuild on the smoke test invalidates the molformer_emb.pt cache
# in case a prior schema version is sitting next to the dataset folder.
# Real perfolder runs share the same flag, so this matches behavior.
python training/train_trace_kin.py \
    --datafolder "$SMOKE_DATASET_DIR" \
    --result_path "$SMOKE_RESULT_BASE" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs 2 \
    --batch_size 16 \
    --seed 1 \
    --lrate 1e-4 \
    --protein_col Sequence \
    --feature_col protein_features \
    --molformer_path "$MOLFORMER_PATH" \
    --ligand_col Smiles \
    --label_col Label \
    --regression_task \
    --model_version v3 \
    --sample_train 100 \
    --sample_test 50 \
    --force_rebuild

# --- Pass/fail banner --------------------------------------------------------
if ls "$SMOKE_RESULT_BASE"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "SMOKE TEST: PASS"
    echo "Result file: $(ls "$SMOKE_RESULT_BASE"/test_prediction_seed*.csv)"
    echo "Next: bsub -w \"done($LSB_JOBID)\" < training/run_v3_perfolder_s1.lsf"
    echo "      bsub < training/run_v3_perfolder_s2.lsf"
    echo "      bsub < training/run_v3_perfolder_s3.lsf"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "SMOKE TEST: FAIL"
    echo "No test_prediction_seed*.csv produced under $SMOKE_RESULT_BASE."
    echo "Inspect $LSB_JOBID.v3_smoke.stderr before submitting the rerun array."
    echo "=========================================="
    exit 1
fi

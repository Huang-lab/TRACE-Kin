#!/bin/bash
#BSUB -J trace_kin_v4_perfolder_s3[1-10]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 48:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v4 (MAP-GNN) PER-FOLDER + MutaPLM — top-10 RF-gap cells
# =============================================================================
# Submit with:
#     bsub < training/run_v4_perfolder_s1.lsf
#
# v4 = MAP-GNN: v1 GNN backbone + per-residue novelty score + pocket
# attention pool + MoLFormer-XL molecular context residual (preserved
# from v3). Unlike earlier versions, every cell uses MutaPLM as the
# protein embedding (the entire mutation-aware story rests on
# MutaPLM's residue-level mutation sensitivity), instead of the
# per-cell best-RF-baseline embedding.
#
# Per-residue novelty:
#   novelty[r] = ||MutaPLM[r] - aa_typical_mean[aa[r]]|| / aa_typical_std[aa[r]]
# where aa_typical statistics are precomputed once over the training
# corpus and cached at <datafolder>/aa_typical.pt. Mutations stand
# out because their MutaPLM vector deviates from the typical
# embedding for the residue's amino acid type — no explicit (WT,
# mutant) labels needed.
#
# Pocket attention:
#   pocket_logit[r] = MLP([MutaPLM[r], novelty[r], degree(r)])
#   pocket_weight[r] = softmax(pocket_logit) over r in same protein
#   prot_pool = sum_r (pocket_weight[r] * residue_h[r])
#
# Cells: same 10 as v3 (largest historical PSICHIC-vs-RF gap).
# Embedding source forced to MUTAPLM regardless of the per-cell
# best-RF choice in the historical benchmark.
#
# Outputs land under TRACE_Kin_Results_v4_mapgnn/<dataset>/<task_name>/
# so they don't collide with prior v3 trees.
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v4_mapgnn}"
MOLFORMER_PATH="${MOLFORMER_PATH:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/transformersmodels/ibm/MoLFormer-XL-both-10pct}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v4.json}"
EPOCHS="${EPOCHS:-50}"
BATCH_SIZE="${BATCH_SIZE:-16}"
SEED=3
LRATE="${LRATE:-1e-4}"

# --- Per-array-index table (10 cells, no pool, MUTAPLM embedding) ------------
# Same 10 cells as v3, but each uses MUTAPLM embedding folder.
# Format: SOURCE|DATASET_NAME|POOL_DIRS  (POOL_DIRS empty: no pooling.)
JOBS=(
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_cold_drug|"             # 1: kcat_km cold_drug
    "catpred_dataset|catpred_kcat_MUTAPLM_embedding_random|"             # 2: kcat    random
    "inhouse_dataset|inhouse_Kd_MUTAPLM_embedding_random|"               # 3: Kd      random
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_random|"                # 4: kcat_km random
    "EITLEM_dataset|EITLEM_kcat_MUTAPLM_embedding_cold_drug|"            # 5: kcat    cold_drug
    "MPEK_dataset|MPEK_kcat_MUTAPLM_embedding_cold_protein|"             # 6: kcat    cold_protein
    "EITLEM_dataset|EITLEM_km_MUTAPLM_embedding_cold_protein|"           # 7: km      cold_protein
    "catpred_dataset|catpred_ki_MUTAPLM_embedding_cold_protein|"         # 8: ki      cold_protein
    "EITLEM_dataset|EITLEM_kkm_MUTAPLM_embedding_cold_protein|"          # 9: kcat_km cold_protein
    "EITLEM_dataset|EITLEM_kcat_MUTAPLM_embedding_cold_protein|"         # 10: kcat   cold_protein
)

# --- Resolve this array task's row ------------------------------------------
IDX=$((LSB_JOBINDEX - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#JOBS[@]}" ]; then
    echo "ERROR: LSB_JOBINDEX=$LSB_JOBINDEX out of range (1..${#JOBS[@]})"
    exit 2
fi
ROW="${JOBS[$IDX]}"
IFS='|' read -r SRC NAME POOLS <<< "$ROW"

DATASET_DIR="$ENZYME_BASE/$SRC/$NAME"
RESULT_PATH="$RESULT_BASE/$SRC/$NAME"

# Pool field is always empty for per-folder; keep the parsing logic for
# consistency with the other LSFs.
POOL_TRAIN_CSVS=""
if [ -n "$POOLS" ]; then
    IFS=';' read -ra REL_LIST <<< "$POOLS"
    ABS_LIST=()
    for rel in "${REL_LIST[@]}"; do
        ABS_LIST+=("$ENZYME_BASE/$rel")
    done
    POOL_TRAIN_CSVS=$(IFS=','; echo "${ABS_LIST[*]}")
fi

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v4 (MAP-GNN) PER-FOLDER task ${LSB_JOBINDEX}/${#JOBS[@]}"
echo "=========================================="
echo "Date:        $(date)"
echo "Dataset:     $DATASET_DIR"
echo "Result:      $RESULT_PATH"
echo "Config:      $CONFIG_PATH"
echo "MoLFormer:   $MOLFORMER_PATH"
echo "Pool CSVs:   ${POOL_TRAIN_CSVS:-(none — per-folder)}"
echo "Model:       v4 MAP-GNN (per-folder, no pool, MUTAPLM + novelty + pocket attn + MoLFormer ctx)"
echo "Epochs:      $EPOCHS, batch=$BATCH_SIZE, seed=$SEED, lr=$LRATE"
echo "=========================================="

python --version
echo "Python: $(which python)"
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
print(f"CUDA device: {torch.cuda.get_device_name(0)}, "
      f"sm_{torch.cuda.get_device_capability(0)[0]}{torch.cuda.get_device_capability(0)[1]}")
PY

# --- Train -------------------------------------------------------------------
# --force_rebuild stays unconditional. ligand.pt + protein.pt + aa_typical.pt
# all live next to the dataset folder; rebuilding ensures all 3 seeds use
# consistent on-disk artifacts and avoids races.
EXTRA_ARGS=(--force_rebuild)
if [ -n "$POOL_TRAIN_CSVS" ]; then
    EXTRA_ARGS+=(--pool_train_csvs "$POOL_TRAIN_CSVS")
fi

python training/train_trace_kin.py \
    --datafolder "$DATASET_DIR" \
    --result_path "$RESULT_PATH" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs "$EPOCHS" \
    --batch_size "$BATCH_SIZE" \
    --seed "$SEED" \
    --lrate "$LRATE" \
    --protein_col Sequence \
    --feature_col protein_features \
    --molformer_path "$MOLFORMER_PATH" \
    --ligand_col Smiles \
    --label_col Label \
    --regression_task \
    --model_version v4 \
    "${EXTRA_ARGS[@]}"

# --- Result check ------------------------------------------------------------
if ls "$RESULT_PATH"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: OK ($NAME)"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: FAIL ($NAME)"
    echo "No test_prediction_seed*.csv at $RESULT_PATH"
    echo "=========================================="
    exit 1
fi

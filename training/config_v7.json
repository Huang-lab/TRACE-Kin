{
    "_comment": "TRACE-Kin v7: Structure-Guided Embedding Distillation (SGED). Dual-stream: (1) Structure Stream — GPS Graph Transformer (GATv2 local + global self-attention, 3 layers, 8+8 heads) -> pocket identification -> MMCAF -> hierarchical pooling. (2) Embedding Stream — raw MutaPLM 4096-d -> Mutation-Aware Gate -> Multi-Scale PCER (catalytic K=16, pocket K=64, global) with detached pocket scores. Ligand: PNA GNN + MoLFormer-XL (768-d).",
    "model_version": "v7",
    "tasks": {
        "regression_task": false,
        "classification_task": false,
        "mclassification_task": 0
    },
    "optimizer": {
        "lrate": 0.0003,
        "weight_decay": 0.01,
        "clip": 1,
        "betas": [0.9, 0.999],
        "eps": 1e-08,
        "schedule_lr": true,
        "min_lrate": 1e-06,
        "warmup_iters": 500,
        "lr_decay_iters": null,
        "amsgrad": false,
        "patience": 25
    },
    "params": {
        "mol_in_channels": 43,
        "prot_in_channels": 33,
        "prot_evo_channels": 4096,
        "hidden_channels": 200,
        "d_model": 512,
        "n_gat_layers": 3,
        "n_gat_heads": 8,
        "gat_rbf_dim": 16,
        "graph_pe_rwse_steps": 16,
        "pocket_k": 64,
        "pcer_k_catalytic": 16,
        "pcer_k_pocket": 64,
        "use_mutation_gate": true,
        "n_global_heads": 8,
        "use_graph_transformer": true,
        "n_pred_heads": 3,
        "emb_recon_weight": 0.1,
        "n_drug_pna_layers": 3,
        "n_cross_heads": 8,
        "chembert_dim": 768,
        "dropout": 0.1,
        "aggregators": ["mean", "min", "max", "std"],
        "scalers": ["identity", "amplification", "linear"],
        "pre_layers": 2,
        "post_layers": 1,
        "total_layer": 3,
        "K": [5, 10, 20],
        "dropout_attn_score": 0.2,
        "heads": 8,
	"mol_pe_mode": "lspe",  "mol_pe_steps": 8, "mol_pe_dim": 16 
    },
    "swa": {
        "use_swa": false,
        "swa_start_frac": 0.5,
        "swa_lr_factor": 0.1
    }
}

#!/bin/bash
#BSUB -J trace_kin_v3_perfolder_s3[1-27]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 48:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v3 PER-FOLDER evaluation — 27 cells, NO cross-dataset pool
# =============================================================================
# Submit with:
#     bsub < training/run_v3_perfolder_s1.lsf
#
# Per-folder evaluation: each (dataset × kinetic × split) cell gets its own
# v3 model trained ONLY on that folder's train.parquet, tested on that
# folder's test.parquet. NO cross-dataset pooling — avoids the leakage
# concern that pool-train rows could contaminate primary-test keys.
#
# Embedding choice per cell: the embedding with the LOWEST RF baseline RMSE
# from trace_doc/kinetic_regress_benchmark.csv. This makes RF as strong as
# possible on the chosen embedding — the hardest fair test for v3.
#
# 27 cells span all 5 kinetics × 3 splits × the 1-3 source datasets each
# kinetic has. See JOBS array below for the full list.
#
# Outputs land under TRACE_Kin_Results_v3_perfolder/<dataset>/<task_name>/
# so they don't collide with the existing TRACE_Kin_Results_v3/ tree.
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v3_perfolder}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v3.json}"
EPOCHS="${EPOCHS:-100}"
BATCH_SIZE="${BATCH_SIZE:-16}"
SEED=3
LRATE="${LRATE:-1e-4}"

# --- Per-array-index table (27 cells, no pool) -------------------------------
# Each cell uses the embedding with the LOWEST RF baseline RMSE for that
# (dataset × kinetic × split) combination. Format: SOURCE|DATASET_NAME|POOL_DIRS
# POOL_DIRS empty for all (per-folder optimization, no cross-dataset pool).
JOBS=(
    # Km — 9 cells (3 datasets × 3 splits)
    "EITLEM_dataset|EITLEM_km_ProteinCLIP_embedding_random|"
    "MPEK_dataset|MPEK_km_ESMv1_embedding_random|"
    "catpred_dataset|catpred_km_ESM2_embedding_random|"
    "EITLEM_dataset|EITLEM_km_ESMv1_embedding_cold_drug|"
    "MPEK_dataset|MPEK_km_ProteinCLIP_embedding_cold_drug|"
    "catpred_dataset|catpred_km_ESM2_embedding_cold_drug|"
    "EITLEM_dataset|EITLEM_km_ProteinCLIP_embedding_cold_protein|"
    "MPEK_dataset|MPEK_km_ProteinCLIP_embedding_cold_protein|"
    "catpred_dataset|catpred_km_ProteinCLIP_embedding_cold_protein|"
    # kcat — 9 cells (3 datasets × 3 splits)
    "EITLEM_dataset|EITLEM_kcat_ESMv1_embedding_random|"
    "MPEK_dataset|MPEK_kcat_ESMv1_embedding_random|"
    "catpred_dataset|catpred_kcat_ESMv1_embedding_random|"
    "EITLEM_dataset|EITLEM_kcat_ESM2_embedding_cold_drug|"
    "MPEK_dataset|MPEK_kcat_ESM2_embedding_cold_drug|"
    "catpred_dataset|catpred_kcat_ESM2_embedding_cold_drug|"
    "EITLEM_dataset|EITLEM_kcat_ProteinCLIP_embedding_cold_protein|"
    "MPEK_dataset|MPEK_kcat_ProteinCLIP_embedding_cold_protein|"
    "catpred_dataset|catpred_kcat_ProteinCLIP_embedding_cold_protein|"
    # kcat/Km (kkm) — 3 cells (only EITLEM has kkm)
    "EITLEM_dataset|EITLEM_kkm_ESM2_embedding_random|"
    "EITLEM_dataset|EITLEM_kkm_ESMv1_embedding_cold_drug|"
    "EITLEM_dataset|EITLEM_kkm_ProteinCLIP_embedding_cold_protein|"
    # Kd — 3 cells (only inhouse has Kd)
    "inhouse_dataset|inhouse_Kd_ESMv1_embedding_random|"
    "inhouse_dataset|inhouse_Kd_ESM2_embedding_cold_drug|"
    "inhouse_dataset|inhouse_Kd_ESMv1_embedding_cold_protein|"
    # Ki — 3 cells (only catpred has Ki)
    "catpred_dataset|catpred_ki_ESMv1_embedding_random|"
    "catpred_dataset|catpred_ki_ESM2_embedding_cold_drug|"
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_cold_protein|"
)

# --- Resolve this array task's row ------------------------------------------
IDX=$((LSB_JOBINDEX - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#JOBS[@]}" ]; then
    echo "ERROR: LSB_JOBINDEX=$LSB_JOBINDEX out of range (1..${#JOBS[@]})"
    exit 2
fi
ROW="${JOBS[$IDX]}"
IFS='|' read -r SRC NAME POOLS <<< "$ROW"

DATASET_DIR="$ENZYME_BASE/$SRC/$NAME"
RESULT_PATH="$RESULT_BASE/$SRC/$NAME"

# Pool field is always empty for per-folder; keep the parsing logic for
# consistency with the other LSFs.
POOL_TRAIN_CSVS=""
if [ -n "$POOLS" ]; then
    IFS=';' read -ra REL_LIST <<< "$POOLS"
    ABS_LIST=()
    for rel in "${REL_LIST[@]}"; do
        ABS_LIST+=("$ENZYME_BASE/$rel")
    done
    POOL_TRAIN_CSVS=$(IFS=','; echo "${ABS_LIST[*]}")
fi

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v3 PER-FOLDER task ${LSB_JOBINDEX}/${#JOBS[@]}"
echo "=========================================="
echo "Date:        $(date)"
echo "Dataset:     $DATASET_DIR"
echo "Result:      $RESULT_PATH"
echo "Config:      $CONFIG_PATH"
echo "Pool CSVs:   ${POOL_TRAIN_CSVS:-(none — per-folder)}"
echo "Model:       v3 (per-folder, no pool, best embedding by RF baseline)"
echo "Epochs:      $EPOCHS, batch=$BATCH_SIZE, seed=$SEED, lr=$LRATE"
echo "=========================================="

python --version
echo "Python: $(which python)"
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
print(f"CUDA device: {torch.cuda.get_device_name(0)}, "
      f"sm_{torch.cuda.get_device_capability(0)[0]}{torch.cuda.get_device_capability(0)[1]}")
PY

# --- Train -------------------------------------------------------------------
# --force_rebuild only on SEED=1 to populate the ligand.pt cache with Morgan +
# MACCS fingerprints; subsequent seeds reuse the cache. (For per-folder runs,
# each cell's cache is independent because each has its own --datafolder.)
EXTRA_ARGS=()
if [ -n "$POOL_TRAIN_CSVS" ]; then
    EXTRA_ARGS+=(--pool_train_csvs "$POOL_TRAIN_CSVS")
fi
if [ "$SEED" = "1" ]; then
    EXTRA_ARGS+=(--force_rebuild)
fi

python training/train_trace_kin.py \
    --datafolder "$DATASET_DIR" \
    --result_path "$RESULT_PATH" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs "$EPOCHS" \
    --batch_size "$BATCH_SIZE" \
    --seed "$SEED" \
    --lrate "$LRATE" \
    --protein_col Sequence \
    --feature_col protein_features \
    --ligand_col Smiles \
    --label_col Label \
    --regression_task \
    --model_version v3 \
    "${EXTRA_ARGS[@]}"

# --- Result check ------------------------------------------------------------
if ls "$RESULT_PATH"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: OK ($NAME)"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: FAIL ($NAME)"
    echo "No test_prediction_seed*.csv at $RESULT_PATH"
    echo "=========================================="
    exit 1
fi

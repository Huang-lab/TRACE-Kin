#!/bin/bash
#BSUB -J trace_kin_v3_perfolder_s3[1-10]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 48:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v3 PER-FOLDER + ChemBERT context — top-10 RF-gap cells
# =============================================================================
# Submit with:
#     bsub < training/run_v3_perfolder_s1.lsf
#
# Per-folder evaluation: each (dataset × kinetic × split) cell gets its own
# v3 model trained ONLY on that folder's train.parquet, tested on that
# folder's test.parquet. NO cross-dataset pooling — avoids the leakage
# concern that pool-train rows could contaminate primary-test keys.
#
# v3 = v1 GNN backbone + ChemBERT (768) projected to hidden_channels and
# added as a global-graph-context residual to mol_pool, before a fresh
# regression head. The previous FP-MLP/gate variant regressed (single MLP
# can't decompose 768-d ChemBERT on small per-folder train sets); this
# variant injects the ChemBERT signal via the GNN's pooled representation
# instead. ChemBERT comes from per-row `metabolite_features` in parquet.
#
# Cells: the 10 (out of 27) where the historical PSICHIC-vs-RF gap is
# largest, derived from data/benchmark/kinetic_regress_benchmark_clean.csv.
# These are the cells the ChemBERT cutover is most likely to move. The
# embedding per cell is the one with the LOWEST RF baseline RMSE in the
# benchmark (= the hardest fair test for v3). All 5 kinetics, all 3 splits,
# and all 4 source datasets are represented.
#
# Ordered by descending RF-gap (PSICHIC RMSE − RF RMSE):
#   1. EITLEM   kcat_km cold_drug    ESMv1       gap +0.135
#   2. catpred  kcat    random       ESMv1       gap +0.130
#   3. inhouse  Kd      random       ESMv1       gap +0.115
#   4. EITLEM   kcat_km random       ESM2        gap +0.098
#   5. EITLEM   kcat    cold_drug    ESM2        gap +0.093
#   6. MPEK     kcat    cold_protein ProteinCLIP gap +0.092
#   7. EITLEM   km      cold_protein ProteinCLIP gap +0.090
#   8. catpred  ki      cold_protein ProteinCLIP gap +0.085
#   9. EITLEM   kcat_km cold_protein ProteinCLIP gap +0.080
#  10. EITLEM   kcat    cold_protein ProteinCLIP gap +0.073
#
# Outputs land under TRACE_Kin_Results_v3_chembert_ctx/<dataset>/<task_name>/
# so they don't collide with the prior FP-MLP TRACE_Kin_Results_v3_chembert/
# tree or any older v3 results.
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
RESULT_BASE="${RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v3_chembert_ctx}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v3.json}"
EPOCHS="${EPOCHS:-30}"
BATCH_SIZE="${BATCH_SIZE:-16}"
SEED=3
LRATE="${LRATE:-1e-4}"

# --- Per-array-index table (10 cells, no pool) -------------------------------
# Top-10 cells by historical RF gap (PSICHIC RMSE − RF RMSE), descending.
# Each cell uses the embedding with the LOWEST RF baseline RMSE for that
# (dataset × kinetic × split) combination — the hardest fair test for v3.
# Format: SOURCE|DATASET_NAME|POOL_DIRS  (POOL_DIRS empty: no pooling.)
JOBS=(
    "EITLEM_dataset|EITLEM_kkm_ESMv1_embedding_cold_drug|"             # 1: kcat_km cold_drug   gap +0.135
    "catpred_dataset|catpred_kcat_ESMv1_embedding_random|"             # 2: kcat    random       gap +0.130
    "inhouse_dataset|inhouse_Kd_ESMv1_embedding_random|"               # 3: Kd      random       gap +0.115
    "EITLEM_dataset|EITLEM_kkm_ESM2_embedding_random|"                 # 4: kcat_km random       gap +0.098
    "EITLEM_dataset|EITLEM_kcat_ESM2_embedding_cold_drug|"             # 5: kcat    cold_drug    gap +0.093
    "MPEK_dataset|MPEK_kcat_ProteinCLIP_embedding_cold_protein|"       # 6: kcat    cold_protein gap +0.092
    "EITLEM_dataset|EITLEM_km_ProteinCLIP_embedding_cold_protein|"     # 7: km      cold_protein gap +0.090
    "catpred_dataset|catpred_ki_ProteinCLIP_embedding_cold_protein|"   # 8: ki      cold_protein gap +0.085
    "EITLEM_dataset|EITLEM_kkm_ProteinCLIP_embedding_cold_protein|"    # 9: kcat_km cold_protein gap +0.080
    "EITLEM_dataset|EITLEM_kcat_ProteinCLIP_embedding_cold_protein|"   # 10: kcat   cold_protein gap +0.073
)

# --- Resolve this array task's row ------------------------------------------
IDX=$((LSB_JOBINDEX - 1))
if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#JOBS[@]}" ]; then
    echo "ERROR: LSB_JOBINDEX=$LSB_JOBINDEX out of range (1..${#JOBS[@]})"
    exit 2
fi
ROW="${JOBS[$IDX]}"
IFS='|' read -r SRC NAME POOLS <<< "$ROW"

DATASET_DIR="$ENZYME_BASE/$SRC/$NAME"
RESULT_PATH="$RESULT_BASE/$SRC/$NAME"

# Pool field is always empty for per-folder; keep the parsing logic for
# consistency with the other LSFs.
POOL_TRAIN_CSVS=""
if [ -n "$POOLS" ]; then
    IFS=';' read -ra REL_LIST <<< "$POOLS"
    ABS_LIST=()
    for rel in "${REL_LIST[@]}"; do
        ABS_LIST+=("$ENZYME_BASE/$rel")
    done
    POOL_TRAIN_CSVS=$(IFS=','; echo "${ABS_LIST[*]}")
fi

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v3 PER-FOLDER task ${LSB_JOBINDEX}/${#JOBS[@]}"
echo "=========================================="
echo "Date:        $(date)"
echo "Dataset:     $DATASET_DIR"
echo "Result:      $RESULT_PATH"
echo "Config:      $CONFIG_PATH"
echo "Pool CSVs:   ${POOL_TRAIN_CSVS:-(none — per-folder)}"
echo "Model:       v3 (per-folder, no pool, ChemBERT context residual, best embedding by RF baseline)"
echo "Epochs:      $EPOCHS, batch=$BATCH_SIZE, seed=$SEED, lr=$LRATE"
echo "=========================================="

python --version
echo "Python: $(which python)"
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
print(f"CUDA device: {torch.cuda.get_device_name(0)}, "
      f"sm_{torch.cuda.get_device_capability(0)[0]}{torch.cuda.get_device_capability(0)[1]}")
PY

# --- Train -------------------------------------------------------------------
# --force_rebuild stays unconditional. The ligand.pt cache lives next to
# the dataset folder and stores chembert_fp per ligand. Even though the
# in-memory backfill in preprocess() handles a stale cache, rebuilding
# guarantees a consistent on-disk artifact across all 3 seeds and avoids
# subtle races when multiple seeds touch the same dataset folder.
EXTRA_ARGS=(--force_rebuild)
if [ -n "$POOL_TRAIN_CSVS" ]; then
    EXTRA_ARGS+=(--pool_train_csvs "$POOL_TRAIN_CSVS")
fi

python training/train_trace_kin.py \
    --datafolder "$DATASET_DIR" \
    --result_path "$RESULT_PATH" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs "$EPOCHS" \
    --batch_size "$BATCH_SIZE" \
    --seed "$SEED" \
    --lrate "$LRATE" \
    --protein_col Sequence \
    --feature_col protein_features \
    --metabolite_feature_col metabolite_features \
    --ligand_col Smiles \
    --label_col Label \
    --regression_task \
    --model_version v3 \
    "${EXTRA_ARGS[@]}"

# --- Result check ------------------------------------------------------------
if ls "$RESULT_PATH"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: OK ($NAME)"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "Array task ${LSB_JOBINDEX}/${#JOBS[@]}: FAIL ($NAME)"
    echo "No test_prediction_seed*.csv at $RESULT_PATH"
    echo "=========================================="
    exit 1
fi

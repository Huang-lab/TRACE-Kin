#!/bin/bash
#BSUB -J trace_kin_v7_smoke
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 8
#BSUB -R "rusage[mem=15000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 01:00
#BSUB -o %J.v7_smoke.stdout
#BSUB -eo %J.v7_smoke.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v7 (SGED: Structure-Guided Embedding Distillation) smoke test
# =============================================================================
# Submit with:
#     bsub < training/run_v7_smoke_test.lsf
#
# Purpose: validate the v7 SGED architecture end-to-end on one cell before
# committing the 10-cell x 3-seed array. Checks:
#   - Structure Stream: GATv2 on contact-map -> pocket identification
#   - Embedding Stream: Multi-Scale PCER (K=16,64,all) with Mutation-Aware Gate
#   - Detached pocket_score coupling structure -> embedding streams
#   - Scale gating network + final regression head
#
# Runs train_trace_kin.py with a tiny sample (100 rows, 5 epochs) on
# the EITLEM kkm cold_drug MUTAPLM cell.
#
# After success, chain the per-folder arrays:
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v7_perfolder_s1.lsf
#     bsub < training/run_v7_perfolder_s2.lsf
#     bsub < training/run_v7_perfolder_s3.lsf
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs -------------------------------------------------------------------
ENZYME_BASE="/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset"
RESULT_BASE="/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v7_sged"
MOLFORMER_PATH="/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/transformersmodels/ibm/MoLFormer-XL-both-10pct"
CONFIG_PATH="training/config_v7.json"
DATASET_DIR="$ENZYME_BASE/EITLEM_dataset/EITLEM_kkm_MUTAPLM_embedding_cold_drug"
RESULT_PATH="$RESULT_BASE/_smoke"

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v7 (SGED) Smoke Test"
echo "=========================================="
echo "Date:               $(date)"
echo "Dataset:            $DATASET_DIR"
echo "Result dir:         $RESULT_PATH"
echo "Config:             $CONFIG_PATH"
echo "MoLFormer:          $MOLFORMER_PATH"
echo "Sample size:        100 rows train / 50 test"
echo "Epochs:             5"
echo "Architecture:       SGED = GATv2 Structure Stream + Multi-Scale PCER + Mutation-Aware Gate"
echo "=========================================="

python --version
echo "Python: $(which python)"
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
print(f"CUDA device: {torch.cuda.get_device_name(0)}, "
      f"sm_{torch.cuda.get_device_capability(0)[0]}{torch.cuda.get_device_capability(0)[1]}")
PY

# --- Train -------------------------------------------------------------------
python training/train_trace_kin.py \
    --datafolder "$DATASET_DIR" \
    --result_path "$RESULT_PATH" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs 5 \
    --batch_size 8 \
    --seed 1 \
    --lrate 3e-4 \
    --protein_col Sequence \
    --feature_col protein_features \
    --molformer_path "$MOLFORMER_PATH" \
    --ligand_col Smiles \
    --label_col Label \
    --regression_task \
    --model_version v7 \
    --amp \
    --sample_train 100 \
    --sample_test 50

# --- Result check ------------------------------------------------------------
if ls "$RESULT_PATH"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "SMOKE TEST: PASS"
    echo "Result file: $(ls $RESULT_PATH/test_prediction_seed*.csv)"
    echo "Next: bsub -w \"done($LSB_JOBID)\" < training/run_v7_perfolder_s1.lsf"
    echo "      bsub < training/run_v7_perfolder_s2.lsf"
    echo "      bsub < training/run_v7_perfolder_s3.lsf"
    echo "=========================================="
else
    echo ""
    echo "=========================================="
    echo "SMOKE TEST: FAIL"
    echo "No test_prediction_seed*.csv found in $RESULT_PATH"
    echo "Check stderr for errors."
    echo "=========================================="
    exit 1
fi

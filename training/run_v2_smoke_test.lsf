#!/bin/bash
#BSUB -J trace_kin_v2_smoke
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 8
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 00:30
#BSUB -o %J.smoke.stdout
#BSUB -eo %J.smoke.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v2 smoke test
# =============================================================================
# Submit with:
#     bsub < training/run_v2_smoke_test.lsf
#
# Purpose: catch import / config / CUDA-arch problems with the v2 architecture
# *before* committing to the 14-task rerun array. Runs train_trace_kin.py with
# a tiny sample (100 rows, 2 epochs) on one fixed dataset so it finishes in a
# few minutes. Walltime capped at 30 minutes.
#
# After this job finishes, chain the rerun array to it:
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v2_rerun_array.lsf
# =============================================================================

set -euo pipefail

# --- Environment -------------------------------------------------------------
ml purge
# Mount Sinai's /etc/bashrc references unset BASHRCSOURCED; relax -u just here.
set +u
source ~/.bashrc
set -u
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Knobs (override via env if desired) ------------------------------------
ENZYME_BASE="${ENZYME_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/drug_discovery/output/data/enzyme_embeddings_dataset}"
SMOKE_DATASET_DIR="${SMOKE_DATASET_DIR:-$ENZYME_BASE/MPEK_dataset/MPEK_kcat_ESMv1_embedding_random}"
SMOKE_RESULT_BASE="${SMOKE_RESULT_BASE:-/sc/arion/projects/DiseaseGeneCell/Huang_lab_project/wangcDrugRepoProject/TRACE_Kin_Results_v2/_smoke}"
CONFIG_PATH="${CONFIG_PATH:-training/config_v2.json}"

# --- Banner ------------------------------------------------------------------
echo "=========================================="
echo "TRACE-Kin v2 Smoke Test"
echo "=========================================="
echo "Date:               $(date)"
echo "Dataset:            $SMOKE_DATASET_DIR"
echo "Result dir:         $SMOKE_RESULT_BASE"
echo "Config:             $CONFIG_PATH"
echo "Sample size:        100 rows"
echo "Epochs:             2"
echo "=========================================="

python --version
echo "Python: $(which python)"

# --- GPU smoke ---------------------------------------------------------------
python - <<'PY'
import sys, torch
if not torch.cuda.is_available():
    print("ERROR: CUDA not available."); sys.exit(86)
name = torch.cuda.get_device_name(0)
cap = torch.cuda.get_device_capability(0)
print(f"CUDA device: {name}, sm_{cap[0]}{cap[1]}")
PY

# --- Wipe any prior smoke output so the success check is honest --------------
rm -rf "$SMOKE_RESULT_BASE"
mkdir -p "$SMOKE_RESULT_BASE"

# --- Run a tiny v2 training -------------------------------------------------
python training/train_trace_kin.py \
    --datafolder "$SMOKE_DATASET_DIR" \
    --result_path "$SMOKE_RESULT_BASE" \
    --config_path "$CONFIG_PATH" \
    --device cuda:0 \
    --epochs 2 \
    --batch_size 16 \
    --seed 1 \
    --lrate 1e-4 \
    --regression_task \
    --model_version v2 \
    --use_swa \
    --sample_train 100 \
    --sample_test 50 \
    --force_rebuild

# --- Pass/fail banner --------------------------------------------------------
if ls "$SMOKE_RESULT_BASE"/test_prediction_seed*.csv 1>/dev/null 2>&1; then
    echo ""
    echo "=========================================="
    echo "SMOKE TEST: PASS"
    echo "Result file: $(ls "$SMOKE_RESULT_BASE"/test_prediction_seed*.csv)"
    echo "Next: bsub -w \"done($LSB_JOBID)\" < training/run_v2_rerun_array.lsf"
    echo "=========================================="
    exit 0
else
    echo ""
    echo "=========================================="
    echo "SMOKE TEST: FAIL"
    echo "No test_prediction_seed*.csv produced under $SMOKE_RESULT_BASE."
    echo "Inspect $LSB_JOBID.smoke.stderr before submitting the rerun array."
    echo "=========================================="
    exit 1
fi

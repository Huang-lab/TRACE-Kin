# Cursor indexing — exclude bulky data, checkpoints, and HPC logs.
# Gitignore-style patterns, relative to this workspace root only.
# For another project folder: copy this file to that root or add a multi-root workspace with its own .cursorignore.

# Whole directories (~GB scratch, job logs)
to_remove/

# Checkpoints, tensors, and common scientific/binary blobs
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.h5
**/*.hdf5
**/*.npy
**/*.npz
**/*.pkl
**/*.pickle
**/*.parquet
**/*.feather

# Large split tables under pdb2020 (human_dataset.csv etc. stay indexed)
dataset/pdb2020/*.csv

# Large notebooks with heavy outputs (~4MB each)
Run_PSICHIC.ipynb
PSICHIC.ipynb

# LSBATCH: User input
#!/bin/bash
#BSUB -J trace_kin_v4_perfolder_s1[1-10]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=15000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 48:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v4 (MAP-GNN) PER-FOLDER + MutaPLM — top-10 RF-gap cells
# =============================================================================
# Submit with:
#     bsub < training/run_v4_perfolder_s1.lsf
#
# v4 = MAP-GNN: v1 GNN backbone + per-residue novelty score + pocket
# attention pool + MoLFormer-XL molecular context residual (preserved
# from v3). Unlike earlier versions, every cell uses MutaPLM as the
# protein embedding (the entire mutation-aware story rests on
# MutaPLM's residue-level mutation sensitivity), instead of the
# per-cell best-RF-baseline embedding.
#
# Per-residue novelty:
#   novelty[r] = ||MutaPLM[r] - aa_typical_mean[aa[r]]|| / aa_typical_std[aa[r]]
# where aa_typical statistics are precomputed once over the training
# corpus and cached at <datafolder>/aa_typical.pt. Mutations stand
# out because their MutaPLM vector deviates from the typical
# embedding for the residue's amino acid type — no explicit (WT,
# mutant) labels needed.
#
# Pocket attention:
#   pocket_logit[r] = MLP([MutaPLM[r], novelty[r], degree(r)])
#   pocket_weight[r] = softmax(pocket_logit) over r in same protein
#   prot_pool = sum_r (pocket_weight[r] * residue_h[r])
#
# Cells: same 10 as v3 (largest historical PSICHIC-vs-RF gap).
# Embedding source forced to MUTAPLM regardless of the per-cell
# best-RF choice in the historical benchmark.
#
# Outputs land under TRACE_Kin_Results_v4_mapgnn/<dataset>/<task_name>/
# so they don't collide with prior v3 trees.
# =============================================================================

# --- Environment -------------------------------------------------------------
ml purge


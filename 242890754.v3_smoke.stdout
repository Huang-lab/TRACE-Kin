# =============================================================================
# TRACE-Kin v3 + ChemBERT context residual smoke test
# =============================================================================
# Submit with:
#     bsub < training/run_v3_smoke_test.lsf
#
# Purpose: validate the v3-with-ChemBERT-context architecture end-to-end
# on one cell before committing the 10-cell × 3-seed perfolder array.
# Catches:
#   - parquet `metabolite_features` parsing / build_smi2chembert
#   - chembert_fp shape (B, 768) flowing through MultiGraphData → trainer
#   - net_v3 chembert_proj (Linear 768 → 200) + reg_out fresh head
#   - zero-init chembert_proj means epoch 0 ≈ v1 baseline (sanity check)
#   - virtual_screening + final test prediction CSV with the new kwarg
#
# Runs train_trace_kin.py with a tiny sample (100 rows, 2 epochs) on one
# fixed dataset so it finishes in a few minutes. Walltime capped at 30 min.
#
# After this job finishes, chain the perfolder arrays to it:
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v3_perfolder_s1.lsf
#     bsub < training/run_v3_perfolder_s2.lsf
#     bsub < training/run_v3_perfolder_s3.lsf
# (s2 and s3 don't need the dependency: each cell rebuilds its own cache
# unconditionally, so all three seeds can run independently.)
# =============================================================================

# --- Environment -------------------------------------------------------------
# Match the prologue of the proven-working PSICHIC LSFs verbatim — no
# `set -euo pipefail`. Mount Sinai's /etc/profile.d scripts return non-zero
# in places that aren't real errors, and errexit aborts the job before
# module + conda activation can complete.
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0


# LSBATCH: User input
#!/bin/bash
#BSUB -J trace_kin_v2[1-14]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q gpu
#BSUB -R h100nvl
#BSUB -gpu num=1
#BSUB -n 16
#BSUB -R "rusage[mem=8000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 48:00
#BSUB -o %J.%I.stdout
#BSUB -eo %J.%I.stderr
#BSUB -L /bin/bash

# =============================================================================
# TRACE-Kin v2 rerun — LSF job array
# =============================================================================
# Submit with:
#     bsub < training/run_v2_rerun_array.lsf
#
# Or chain off the smoke test (recommended):
#     bsub -w "done(<SMOKE_JOB_ID>)" < training/run_v2_rerun_array.lsf
#
# LSF expands #BSUB -J trace_kin_v2[1-14] into 14 array tasks, each with a
# distinct ${LSB_JOBINDEX} in 1..14. The body looks up the per-index
# (dataset_source, dataset_name, pool_paths) tuple from the inline table below
# and invokes train_trace_kin.py with model_version=v2 + SWA.
#
# The 14 tasks correspond to:
#   * 12 RF-gap targets (catalytic kinetics where v1 trails RF by 1.4%–8.7%)
#   * 2 Ki preservation guards (where v1 already wins, must not regress)
# =============================================================================

# --- Environment -------------------------------------------------------------
# Match the prologue of the proven-working PSICHIC LSFs verbatim — no
# `set -euo pipefail`. Mount Sinai's /etc/profile.d scripts return non-zero
# in places that aren't real errors, and errexit aborts the job before
# module + conda activation can complete.
ml purge
source ~/.bashrc
module load anaconda3/2024.06
source activate test
module load cuda/12.4.0
export RAYON_NUM_THREADS=4
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Put the repo root on PYTHONPATH so `from training.X import …` works when
# train_trace_kin.py is invoked as a script (not via `python -m`).
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# --- Knobs (env overrides) ---------------------------------------------------

